			  function replaceAll( text, busca, reemplaza ){

				    while (text.toString().indexOf(busca) != -1)
	
				        text = text.toString().replace(busca,reemplaza);
			
				    return text;
			
				  }
				  			  
		
			// Init the page.
			function initMasks(){
			
       		jQuery(".formatDate").keypress(
       				function( objEvent ){
       					var charCode = objEvent.charCode;
       					if (charCode > 31 && (charCode < 48 || charCode > 57))
       					     return false;
				        return true;
       				}
			);
			jQuery(".formatDate").keyup(
					function( objEvent ){
						if (objEvent.keyCode >= 32) {
							numeros = replaceAll(this.value,"/","");

							if (this.value.length > 11) {
								this.value = replaceAll(this.value,"/","");
								this.value = this.value.substring(0,2) + "/" + this.value.substring(2,4) + "/" +
								this.value.substring(4,8);
								this.value = this.value.substring(0,10);
								return; 
							}
							
							if (this.value.length > 10) {
								this.value = this.value.substring(0,10);
								return;
							}
							
							if (this.value.length == 2) {
								this.value = this.value + "/";
								return;
							}

							if (this.value.length == 3) {
								if (numeros.length==3) {
									this.value = this.value.substring(0,2) + "/" + this.value.substring(2);
									return;
								}
							}
							if (this.value.length == 5) {
								this.value = this.value + "/";
								return;
							}

							if (this.value.length == 6) {
								if (numeros.length==5) {
									this.value = this.value.substring(0,5) + "/" + this.value.substring(5);
									return;
								}
							}
							//alert(this.value)
						}
					}
					);



					jQuery(".formatHours").keypress(
		       				function( objEvent ){
		       					var charCode = objEvent.charCode;
		       					if (charCode > 31 && (charCode < 48 || charCode > 57))
		       					     return false;
						        return true;
		       				}
					);
					jQuery(".formatHours").keyup(
							function( objEvent ){
								if (objEvent.keyCode >= 32) {
									numeros = replaceAll(this.value,":","");
									if (this.value.length > 6) {
										this.value = replaceAll(this.value,":","");
										this.value = this.value.substring(0,2) + ":" + this.value.substring(2,4);
										return;
									}
									if (this.value.length > 5) {
										this.value = this.value.substring(0,5);
										return;
									}
									
									if (this.value.length == 2) {
										this.value = this.value + ":";
										return;
									}
		
									if (this.value.length == 3) {
										if (numeros.length==3) {
											this.value = this.value.substring(0,2) + ":" + this.value.substring(2);
											return;
										}
									}
								
								}
							}
							);


					jQuery(".formatPeriod").keypress(
		       				function( objEvent ){
		       					var charCode = objEvent.charCode;
		       					if (charCode > 31 && (charCode < 48 || charCode > 57))
		       					     return false;
						        return true;
		       				}
					);
					jQuery(".formatPeriod").keyup(
							function( objEvent ){
								if (objEvent.keyCode >= 32) {
									numeros = replaceAll(this.value,"/","");

									if (this.value.length > 8) {
										this.value = replaceAll(this.value,"/","");
										this.value = this.value.substring(0,2) + "/" + this.value.substring(2,6) ;
										
										return;
									}
									
									if (this.value.length > 7) {
										this.value = this.value.substring(0,7);
										return;
									}
									
									if (this.value.length == 2) {
										this.value = this.value + "/";
										return;
									}

									if (this.value.length == 3) {
										if (numeros.length==3) {
											this.value = this.value.substring(0,2) + "/" + this.value.substring(2);
											return;
										}
									}

								}
							}
							);




			
			}
			
			//]]>
		</script>
	
